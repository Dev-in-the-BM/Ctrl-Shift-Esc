---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import { getEntry, getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import type { MetaData } from '~/types';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

// Reach into Astro's content collection to extract the hidden headings array
let headings = [];
try {
  // First try to get headings directly from the post's rendered Content
  // This avoids needing to re-lookup the entry
  if (post.Content) {
    // For posts that have pre-rendered Content, we can't easily get headings
    // without re-rendering, so fall through to the getEntry approach
  }
  
  // Try to find the entry by slug via getEntry first
  let entry = await getEntry('post', post.slug);
  
  // If not found, try to find by id
  if (!entry && post.id) {
    entry = await getEntry('post', post.id.replace(/\.mdx?$/, ''));
  }
  
  // If still not found, try finding from collection by slug
  if (!entry) {
    const allEntries = await getCollection('post');
    entry = allEntries.find((e) => e.id === post.slug || e.id === post.id || e.slug === post.slug);
  }
  
  if (entry) {
    const rendered = await render(entry);
    headings = rendered.headings || [];
  } else if (typeof (post as any).getHeadings === 'function') {
    headings = await (post as any).getHeadings() || [];
  }
} catch (e) {
  console.error("Error fetching ToC headings:", e);
}

const isUnlisted = post.id.startsWith('.');

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: isUnlisted ? false : blogPostRobots?.index,
      follow: isUnlisted ? false : blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image
        ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;
---

<Layout metadata={metadata}>
  <SinglePost post={{ ...post, image: image }} url={url} headings={headings}>
    {post.Content ? <post.Content /> : <Fragment set:html={post.content || ''} />}
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
