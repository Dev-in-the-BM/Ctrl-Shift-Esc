---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, fetchUnlistedPosts, getStaticPathsBlogList } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const unlistedPosts = import.meta.env.DEV ? await fetchUnlistedPosts() : [];

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="My thoughts on dumbphones, intentional tech and the systems underneath: <br> The tinkerers guide to taking back control."
    >
      In Plaintext
    </Headline>

    <div
      class="max-w-2xl mx-auto mt-8 mb-12 p-4 bg-gray-50 dark:bg-slate-800 rounded-lg shadow-md flex flex-col sm:flex-row justify-around items-center text-center gap-4"
    >
      <a href="/category/typed-with-t9"
        class="text-lg font-semibold text-gray-800 dark:text-gray-200 hover:underline px-2 py-1 rounded-md hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200 whitespace-nowrap">
        Typed With T9
      </a>
      <a href="/category/dialing-down"
        class="text-lg font-semibold text-gray-800 dark:text-gray-200 hover:underline px-2 py-1 rounded-md hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200 whitespace-nowrap">
        Dialing Down
      </a>
      <a href="/category/~/Tinkering"
        class="text-lg font-semibold text-gray-800 dark:text-gray-200 hover:underline px-2 py-1 rounded-md hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200 whitespace-nowrap">
        ~/Tinkering
      </a>
    </div>
    {
      unlistedPosts.length > 0 && (
        <aside class="max-w-2xl mx-auto mb-10 rounded-lg border border-amber-300 bg-amber-50 p-4 text-amber-950 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100">
          <h2 class="mb-1 font-semibold">Unlisted pages — local preview</h2>
          <p class="mb-3 text-sm">These pages are hidden from the public blog and appear here only in development.</p>
          <ul class="space-y-2">
            {unlistedPosts.map((post) => (
              <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <a class="font-medium underline underline-offset-2" href={getPermalink(post.permalink, 'post')}>
                  {post.title}
                </a>
                <code class="break-all text-xs opacity-80">{getPermalink(post.permalink, 'post')}</code>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>
</Layout>
