---
import { Icon } from 'astro-icon/components';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import { Image } from 'astro:assets';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink, getBlogPermalink } from '~/utils/permalinks';
import { trimSlash, getAsset, getPermalink } from '~/utils/permalinks';
import type { CallToAction } from '~/types';
import { getCollection } from 'astro:content';
import { SITE } from 'astrowind:config';

import avatarImage from '~/assets/Avatar scaled down-min.webp';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  // isSticky?: boolean; // Removed as we're implementing custom scroll behavior
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  // isSticky = false, // Removed as we're implementing custom scroll behavior
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const posts = await getCollection('post');
const cleanSlug = (text: string) => text.toString().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

const uniqueCategories = Array.from(new Set(posts.map(p => p.data.category).filter(Boolean))).map(title => ({ title: title as string, slug: cleanSlug(title as string) }));
const uniqueTags = Array.from(new Set(posts.flatMap(p => p.data.tags || []).filter(Boolean))).map(title => ({ title: title as string, slug: cleanSlug(title as string) }));
---

<header
  class:list={[
    { dark: isDark },
    'relative z-40 flex-none mx-auto w-full border-b border-gray-50/0',
  ]}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between items-center']}>
      <a class="flex items-center" href="https://dev-in-the-bm.github.io">
        <Image
          src={avatarImage}
          alt="Dev in the BM Avatar"
          width={40}
          height={40}
          class="rounded-full object-cover ml-2 rtl:ml-0 rtl:mr-2"
        />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-visible md:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
      >
        {
          links.map(({ text, href, links }) => {
            const isBlogTab = text === 'Blog' || href === getBlogPermalink();
            return (
            <li class={links?.length || isBlogTab ? 'dropdown group relative' : ''}>
              {isBlogTab ? (
                <>
                  <a
                    class:list={[
                      'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={getBlogPermalink()}
                  >
                    {SITE?.name || SITE?.title || text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </a>
                  <ul class="dropdown-menu md:absolute md:top-full left-1/2 -translate-x-1/2 md:!block md:opacity-0 md:invisible group-hover:md:opacity-100 group-hover:md:visible font-medium md:w-[800px] md:max-w-[90vw] shadow-2xl text-sm z-[100] rounded-2xl bg-gray-100 dark:bg-gray-700 transition-all duration-300 ease-out md:translate-y-2 group-hover:md:translate-y-0">
                    <li class="p-4 md:p-6">
                      <div class="flex justify-center space-x-8 mb-6">
                  <button type="button" class="blog-tab-btn active text-lg text-primary dark:text-blue-500 font-semibold transition-colors" data-target="categories-tab">Categories</button>
                  <button type="button" class="blog-tab-btn text-lg text-muted hover:text-gray-900 dark:hover:text-gray-100 transition-colors" data-target="tags-tab">Tags</button>
                      </div>
                      <div id="categories-tab" class="blog-tab-content block">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar text-center">
                          {uniqueCategories.map(cat => (
                            <a href={getPermalink(cat.slug, 'category')} class="text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-500 transition-colors line-clamp-1 py-2">{cat.title}</a>
                          ))}
                        </div>
                      </div>
                      <div id="tags-tab" class="blog-tab-content hidden">
                        <div class="flex flex-wrap justify-center gap-3 max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
                          {uniqueTags.map(tag => (
                            <a href={getPermalink(tag.slug, 'tag')} class="py-1.5 px-4 rounded-lg bg-white dark:bg-slate-800 text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200 lowercase font-medium transition-colors duration-800 ease-out shadow-sm">
                              {tag.title}
                            </a>
                          ))}
                        </div>
                      </div>
                    </li>
                  </ul>
                </>
              ) : links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/90 md:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          )})
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  function initBlogTabs() {
    const tabBtns = document.querySelectorAll('.blog-tab-btn');
    
    tabBtns.forEach(btn => {
      if (btn.getAttribute('data-init')) return;
      btn.setAttribute('data-init', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const container = btn.closest('.dropdown-menu');
        if (!container) return;
        
        const localBtns = container.querySelectorAll('.blog-tab-btn');
        const localContents = container.querySelectorAll('.blog-tab-content');

        localBtns.forEach(b => {
          b.classList.remove('active', 'text-primary', 'dark:text-blue-500', 'font-semibold');
          b.classList.add('text-muted');
        });
        localContents.forEach(c => {
          c.classList.add('hidden');
          c.classList.remove('block');
        });

        const targetId = btn.getAttribute('data-target');
        btn.classList.add('active', 'text-primary', 'dark:text-blue-500', 'font-semibold');
        btn.classList.remove('text-muted');
        
        const targetContent = container.querySelector(`#${targetId}`);
        targetContent?.classList.remove('hidden');
        targetContent?.classList.add('block');
      });
    });
  }
  
  // Supports both standard page loads and Astro's ViewTransitions
  document.addEventListener('astro:page-load', initBlogTabs);
  document.addEventListener('DOMContentLoaded', initBlogTabs);
</script>
