---
import { Icon } from 'astro-icon/components';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import { Image } from 'astro:assets';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink, getBlogPermalink } from '~/utils/permalinks';
import { trimSlash, getAsset, getPermalink } from '~/utils/permalinks';
import type { CallToAction } from '~/types';
import { getCollection } from 'astro:content';
import { SITE } from 'astrowind:config';

import avatarImage from '~/assets/Avatar scaled down-min.webp';
import imgT9 from '~/assets/T9_category.webp';
import imgDialing from '~/assets/Digital_minimalism_reclaiming_202603301538.jpeg';
import imgPlaintext from '~/assets/Terminal_window_code_202603301545.jpeg';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  // isSticky?: boolean; // Removed as we're implementing custom scroll behavior
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  // isSticky = false, // Removed as we're implementing custom scroll behavior
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const posts = await getCollection('post');
const cleanSlug = (text: string) => text.toString().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

const uniqueCategories = Array.from(new Set(posts.map(p => p.data.category).filter(Boolean))).map(title => ({ title: title as string, slug: cleanSlug(title as string) }));
const uniqueTags = Array.from(new Set(posts.flatMap(p => p.data.tags || []).filter(Boolean))).map(title => ({ title: title as string, slug: cleanSlug(title as string) }));

const categoryDetails: Record<string, { subtitle: string; image: any }> = {
  'Typed With T9': {
    subtitle: 'Reviews and insights on dumb hardware.',
    image: imgT9,
  },
  'Dialing Down': {
    subtitle: 'Tools and tactics for intentional tech usage.',
    image: imgDialing, 
  },
  'In Plaintext': {
    subtitle: 'Tinkering with Linux, Android, and the tools underneath.',
    image: imgPlaintext,
  },
};
---

<header
  class:list={[
    { dark: isDark },
    'relative z-40 flex-none mx-auto w-full border-b border-gray-50/0',
  ]}
  {...id ? { id } : {}}
>
  <!-- Mobile Blur Overlay -->
  <div class="fixed inset-0 z-[-1] backdrop-blur-md bg-black/20 md:hidden menu-blur-overlay" aria-hidden="true"></div>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between items-center']}>
      <a class="flex items-center" href="https://dev-in-the-bm.github.io">
        <Image
          src={avatarImage}
          alt="Dev in the BM Avatar"
          width={40}
          height={40}
          class="rounded-full object-cover ml-2 rtl:ml-0 rtl:mr-2"
        />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full absolute md:static top-full left-0 z-[100] md:z-auto md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-visible md:justify-self-center max-h-[80vh] md:max-h-none transition-opacity duration-[300ms] ease-out opacity-0 [.expanded_&]:opacity-100 md:opacity-100 md:transition-none"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
      >
        {
          links.map(({ text, href, links }) => {
            const isBlogTab = text === 'Blog' || href === getBlogPermalink();
            return (
            <li class={links?.length || isBlogTab ? 'dropdown group relative' : ''}>
              {isBlogTab ? (
                <>
                  <div class="hidden md:flex items-center z-[110] relative">
                    <a
                      class:list={[
                        'hover:text-link dark:hover:text-white pl-4 pr-1 py-3 flex items-center whitespace-nowrap transition-colors duration-200',
                        { 'aw-link-active': href === currentPath },
                      ]}
                      href={getBlogPermalink()}
                    >
                      {SITE?.name || SITE?.title || text}
                    </a>
                    <button
                      id="blog-menu-toggle"
                      class="hover:text-link dark:hover:text-white pr-4 pl-1 py-3 flex items-center transition-colors duration-200 focus:outline-none cursor-pointer"
                      aria-label="Toggle Blog Menu"
                    >
                      <Icon name="tabler:chevron-down" id="blog-menu-chevron" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 transition-transform duration-300" />
                    </button>
                  </div>
                  <!-- Blur Overlay -->
                  <div class="fixed inset-0 z-[90] backdrop-blur-md bg-black/20 hidden md:block menu-blur-overlay" aria-hidden="true"></div>
                  <div class="md:absolute md:top-full md:left-1/2 md:!block z-[100] md:pt-2 popup-container" role="menu" aria-orientation="vertical" aria-labelledby="blog-menu-button">
                    <ul class="font-medium md:w-[800px] md:max-w-[90vw] text-sm rounded-2xl bg-white dark:bg-slate-900 shadow-2xl ring-1 ring-black/5 dark:ring-white/10">
                      <li class="p-4 md:p-6">
                      
                      <div class="max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
                        <div class="flex flex-col gap-3 text-left max-w-2xl mx-auto">
                          {uniqueCategories.map((cat, index) => (
                            <a href={getPermalink(cat.slug, 'category')} class="group flex items-center gap-5 p-4 rounded-xl bg-gray-50 dark:bg-slate-800 hover:bg-gray-100 dark:hover:bg-slate-700 popup-item" style={`animation-delay: ${(index + 1) * 100}ms;`}>
                              <Image 
                                src={categoryDetails[cat.title]?.image || avatarImage} 
                                alt={cat.title} 
                                width={128}
                                height={128}
                                class="w-14 h-14 md:w-16 md:h-16 flex-shrink-0 object-cover rounded-lg shadow-sm bg-gray-200 dark:bg-slate-600"
                              />
                              <div class="flex flex-col">
                                <span class="text-lg md:text-xl font-bold text-gray-900 dark:text-white transition-colors">{cat.title}</span>
                                <span class="text-sm text-muted dark:text-slate-400 mt-0.5">{categoryDetails[cat.title]?.subtitle || ''}</span>
                              </div>
                            </a>
                          ))}
                        </div>

                        <div class="flex flex-wrap justify-center gap-3 mt-6 popup-item" style={`animation-delay: ${(uniqueCategories.length + 1) * 100}ms;`}>
                          {uniqueTags.map(tag => (
                            <a href={getPermalink(tag.slug, 'tag')} class="py-1.5 px-4 rounded-lg bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-800 hover:border-gray-200 dark:hover:border-slate-700 text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200 lowercase font-medium transition-all duration-200 ease-out shadow-sm hover:shadow-md">
                              {tag.title}
                            </a>
                          ))}
                        </div>

                        <div id="mobile-theme-toggle-wrapper" class="md:hidden flex justify-center mt-6 pt-5 border-t border-gray-100 dark:border-slate-800 popup-item" style={`animation-delay: ${(uniqueCategories.length + 2) * 100}ms;`}>
                          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6" />}
                        </div>
                      </div>
                      </li>
                    </ul>
                  </div>
                </>
              ) : links?.length ? ( /* This block handles dropdowns for other menu items if they exist */
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/90 md:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          )})
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end transition-opacity duration-300 ease-out opacity-0 [.expanded_&]:opacity-100 md:opacity-100 md:transition-none',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">
          {showToggleTheme && (
            <div class="hidden md:flex items-center">
              <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />
            </div>
          )}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* Blur Overlay */
  .menu-blur-overlay {
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease-out;
  }
  .expanded .menu-blur-overlay,
  .group:hover .menu-blur-overlay,
  .group.pinned .menu-blur-overlay {
    opacity: 1;
    /* pointer-events must remain none so the overlay doesn't trap the mouse hover state! */
  }

  /* Desktop Parent Container */
  @media (min-width: 768px) {
    .popup-container {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(-50%) translateY(8px);
      transition: all 0.3s ease-out;
    }
    .expanded .popup-container,
    .group:hover .popup-container,
    .group.pinned .popup-container {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
  }

  /* Staggered Children Animation */
  @keyframes popup-item-entrance {
    0% { opacity: 0; transform: translateY(16px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  .popup-item {
    /* Base state is visible! This ensures a smooth parent fade-out without snapping */
    opacity: 1; 
    transform: translateY(0);
  }
  
  .expanded .popup-item,
  .group:hover .popup-item,
  .group.pinned .popup-item {
    /* fill-mode: backwards ensures they stay hidden during their stagger delay */
    animation: popup-item-entrance 0.3s ease-out backwards;
  }
</style>

<script>
  let outsideClickListener;

  function setupBlogMenuToggle() {
    const toggleBtn = document.getElementById('blog-menu-toggle');
    const chevron = document.getElementById('blog-menu-chevron');
    
    if (toggleBtn) {
      const groupLi = toggleBtn.closest('.group');
      if (groupLi) {
        toggleBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          groupLi.classList.toggle('pinned');
          if (chevron) {
            chevron.classList.toggle('rotate-180');
          }
        };

        if (outsideClickListener) {
          document.removeEventListener('click', outsideClickListener);
        }
        
        outsideClickListener = function(e) {
          if (!groupLi.contains(e.target)) {
            groupLi.classList.remove('pinned');
            if (chevron) {
              chevron.classList.remove('rotate-180');
            }
          }
        };
        
        document.addEventListener('click', outsideClickListener);
      }
    }

    const mobileThemeWrapper = document.getElementById('mobile-theme-toggle-wrapper');
    if (mobileThemeWrapper) {
      mobileThemeWrapper.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }
  }

  setupBlogMenuToggle();
  document.addEventListener('astro:after-swap', setupBlogMenuToggle);
</script>
