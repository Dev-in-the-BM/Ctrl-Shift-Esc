---
export interface Props {
  url: string | URL;
}

const { url } = Astro.props;
---

<div id="discourse-comments"></div>
<style is:global>
  #discourse-comments-wrapper { /* Target the outer box for resizing */
    resize: vertical;
    overflow: hidden; /* Clips the corner so the resize handle respects the border-radius */
    clip-path: inset(0 0 0 0 round 1rem); /* Force-clips Firefox's native boxy resizer to the rounded corner */
    height: 732px; /* Adjusted default height to ensure iframe content is ~600px with new padding/margin and header changes */
    min-height: 300px;
    /* Universal custom resize handle shade to ensure it is clearly visible on Firefox and others */
    background-image: linear-gradient(135deg, transparent 50%, rgba(156, 163, 175, 0.1) 50%);
    background-size: 24px 24px;
    background-position: bottom right;
    background-repeat: no-repeat;
  }
  /* Expands the hidden native scrollbars, which invisibly forces the WebKit resize hit-area to be larger */
  #discourse-comments-wrapper::-webkit-scrollbar {
    width: 80px;
    height: 80px;
  }
  #discourse-comments-wrapper::-webkit-resizer {
    background-color: transparent; /* Hides the native WebKit gray square so our universal background shows through */
  }
  #discourse-comments {
    /* This div will contain the iframe and should fill its parent (#discourse-comments-wrapper) */
    width: 100%;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  #discourse-comments iframe {
    width: 100%;
    flex-grow: 1;
    height: 100% !important; /* Ensures the iframe stretches with its immediate parent (#discourse-comments) */
    resize: none !important; /* Explicitly prevent iframe from being resizable */
    overflow: hidden !important; /* Prevent internal scrollbars on the iframe itself */
  }
</style>

<script type="text/javascript" is:inline define:vars={{ discourseEmbedUrl: String(url) }}>
  window.DiscourseEmbed = {
    discourseUrl: 'https://forums.jtechforums.org/',
    template: 'complete',
    fullApp: true,
    discourseEmbedUrl: discourseEmbedUrl,
  };

  (function () {
    var d = document.createElement('script');
    d.type = 'text/javascript';
    d.async = true;
    d.src = window.DiscourseEmbed.discourseUrl + 'javascripts/embed.js';
    (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(d);
  })();

  /* Handle resizing and saving the height configuration */
  (function() {
    var container = document.getElementById('discourse-comments-wrapper'); /* Target the outer resizable container */
    if (!container) return;

    var savedHeight = localStorage.getItem('discourse-comments-height');
    if (savedHeight) {
      container.style.height = savedHeight;
    } /* No else needed, CSS handles default height */

    var observer = new ResizeObserver(function(entries) {
      localStorage.setItem('discourse-comments-height', entries[0].contentRect.height + 'px');
    });
    observer.observe(container);
  })();

  /* Handle reload button click */
  (function() {
    var reloadBtn = document.getElementById('reload-discourse-comments');
    if (reloadBtn) {
      var currentRotation = 0;
      reloadBtn.addEventListener('click', function() {
        var iframe = document.querySelector('#discourse-comments iframe');
        if (iframe) iframe.src = iframe.src; /* Safe cross-origin refresh */
        
        /* Animate the icon 360 degrees */
        currentRotation -= 360;
        var icon = reloadBtn.querySelector('svg');
        if (icon) {
          icon.style.transform = 'rotate(' + currentRotation + 'deg)';
        }
      });
    }
  })();
</script>