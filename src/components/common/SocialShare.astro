---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
---

<div class={className}>
  <span class="align-super font-bold text-slate-500 dark:text-slate-400">Share:</span>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share"
    data-aw-social-share="share"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:share"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share with SMS"
    data-aw-social-share="sms"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:message"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share with Email"
    data-aw-social-share="mail"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:mail"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share with Whatsapp"
    data-aw-social-share="whatsapp"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-whatsapp"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share with Telegram"
    data-aw-social-share="telegram"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-telegram"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share with Reddit"
    data-aw-social-share="reddit"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-reddit"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share with Linkedin"
    data-aw-social-share="linkedin"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-linkedin"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2 transition-colors duration-800 ease-out"
    title="Share with X"
    data-aw-social-share="twitter"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-x"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
</div>
